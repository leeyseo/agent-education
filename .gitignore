# 비밀 정보 (ElevenLabs API 키 등)
.env
.env.*

# 만들어지는 결과물: 아래 명령으로 언제든 다시 만들 수 있다
#   python shorts/lib/build.py epNN   → audio/, timeline.js
#   python shorts/lib/render.py epNN  → mp4
*.mp4
*.wav
*.mp3
**/audio/
**/stills/
shorts/완성본/
shorts/voice_samples/

# 화면 녹화 원본과 클립 (계정 화면이 찍혀 있을 수 있어 저장소에 넣지 않는다)
shorts/s2/rec/raw/
shorts/s2/rec/clips/

# 참고용으로 받은 외부 광고 영상
KakaoTalk_*

__pycache__/
*.pyc
